# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env` and fill in.
#
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ reach the browser bundle. Anything here
# is public — never put a secret in this file. All secrets live on the server.
# ---------------------------------------------------------------------------

# Base URL of the API, including the /api prefix.
#
#   Development: http://localhost:3000/api
#   Production:  https://your-api.example.com/api
#
# Axios sends requests with `withCredentials: true` so the HTTP-only refresh
# cookie travels with them. If this points at a different origin than the page
# is served from, that origin must also appear in the backend's CORS_ORIGINS.
VITE_BASE_BACKEND_URL=http://localhost:3000/api