# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the API listens on. Most PaaS platforms (Render, Railway, Fly) inject
# PORT themselves and override this value.
PORT=3000

# Bind address. Must stay 0.0.0.0 in a container or the platform's proxy
# cannot reach the process.
HOST=0.0.0.0

# Mongo connection string.
#   Local:  mongodb://127.0.0.1:27017/planner
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>/planner?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/planner

# REQUIRED. Signs both access and refresh tokens, so changing it invalidates
# every existing session. Must be at least 32 characters — the server refuses
# to boot otherwise, rather than failing later on the user's first login.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_at_least_32_random_characters

# Comma-separated list of browser origins allowed to call the API. The refresh
# token is an HTTP-only cookie, so this is what stops another site from using it.
#
#   Development: http://localhost:5173,http://127.0.0.1:5173
#   Production:  https://your-app.example.com
#
# List both localhost and 127.0.0.1 in development — they are different origins
# to the browser, so a page opened on one cannot call an API allowed only on the
# other.
#
# A request whose Origin is not listed is rejected outright. Same-origin requests
# (no Origin header at all) are allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
